<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ff6955"/>
      <stop offset="100%" stop-color="#ea1b1b"/>
    </linearGradient>
    <linearGradient id="base" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#fcd8d8"/>
    </linearGradient>
    <linearGradient id="stick" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#ea2020"/>
      <stop offset="50%" stop-color="#ff4444"/>
      <stop offset="100%" stop-color="#ba1111"/>
    </linearGradient>
    <radialGradient id="ball" cx="35%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="45%" stop-color="#fde2e2"/>
      <stop offset="90%" stop-color="#e2a6a6"/>
      <stop offset="100%" stop-color="#c97e7e"/>
    </radialGradient>
    <filter id="sh" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="16" stdDeviation="16" flood-color="#8a0c0c" flood-opacity="0.45"/>
    </filter>
  </defs>
  <rect width="512" height="512" rx="115" fill="url(#bg)"/>
  <g filter="url(#sh)">
    <!-- Base Plate Isometric -->
    <path d="M 256 195 L 430 280 C 435 283 435 292 430 295 L 260 380 C 257 382 255 382 252 380 L 82 295 C 77 292 77 283 82 280 Z" fill="#e89898"/>
    <path d="M 82 290 L 82 315 C 82 322 86 328 92 331 L 252 411 C 255 413 257 413 260 411 L 420 331 C 426 328 430 322 430 315 L 430 290 L 260 375 C 257 377 255 377 252 375 Z" fill="#d97d7d"/>
    <path d="M 256 195 L 426 278 C 430 280 430 286 426 288 L 258 372 C 257 373 255 373 254 372 L 86 288 C 82 286 82 280 86 278 Z" fill="url(#base)"/>
    <!-- Red button on base -->
    <ellipse cx="160" cy="285" rx="26" ry="17" fill="#ea2020"/>
    <ellipse cx="160" cy="282" rx="23" ry="14" fill="#ff4d4d"/>
    <!-- Shaft -->
    <rect x="238" y="190" width="36" height="110" rx="18" fill="url(#stick)"/>
    <!-- Top Ball -->
    <circle cx="256" cy="170" r="56" fill="url(#ball)"/>
  </g>
</svg>